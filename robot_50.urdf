<?xml version="1.0"?>

<robot name="low_profile_robot">

    <!-- ====================================== -->
    <!-- 차체 -->
    <!-- 차체 2.8 kg + 바퀴 0.05 kg × 4 -->
    <!-- 전체 질량 = 3.0 kg -->
    <!-- ====================================== -->

    <link name="base_link">

        <inertial>

            <mass value="2.8"/>

            <inertia
                ixx="0.0106633"
                ixy="0"
                ixz="0"
                iyy="0.0186667"
                iyz="0"
                izz="0.0285833"/>

        </inertial>

        <visual>
            <geometry>
                <box size="0.28 0.21 0.04"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="0.28 0.21 0.04"/>
            </geometry>
        </collision>

    </link>


    <!-- 왼쪽 앞바퀴 -->

    <link name="front_left_wheel">

        <inertial>

            <mass value="0.05"/>

            <inertia
                ixx="0.0000104167"
                ixy="0"
                ixz="0"
                iyy="0.0000156250"
                iyz="0"
                izz="0.0000104167"/>

        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </collision>

    </link>

    <joint name="front_left_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_left_wheel"/>

        <origin xyz="0.115 0.1175 -0.025"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- 오른쪽 앞바퀴 -->

    <link name="front_right_wheel">

        <inertial>

            <mass value="0.05"/>

            <inertia
                ixx="0.0000104167"
                ixy="0"
                ixz="0"
                iyy="0.0000156250"
                iyz="0"
                izz="0.0000104167"/>

        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </collision>

    </link>

    <joint name="front_right_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_right_wheel"/>

        <origin xyz="0.115 -0.1175 -0.025"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- 왼쪽 뒷바퀴 -->

    <link name="rear_left_wheel">

        <inertial>

            <mass value="0.05"/>

            <inertia
                ixx="0.0000104167"
                ixy="0"
                ixz="0"
                iyy="0.0000156250"
                iyz="0"
                izz="0.0000104167"/>

        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </collision>

    </link>

    <joint name="rear_left_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_left_wheel"/>

        <origin xyz="-0.115 0.1175 -0.025"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- 오른쪽 뒷바퀴 -->

    <link name="rear_right_wheel">

        <inertial>

            <mass value="0.05"/>

            <inertia
                ixx="0.0000104167"
                ixy="0"
                ixz="0"
                iyy="0.0000156250"
                iyz="0"
                izz="0.0000104167"/>

        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.025"/>
            </geometry>
        </collision>

    </link>

    <joint name="rear_right_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_right_wheel"/>

        <origin xyz="-0.115 -0.1175 -0.025"/>

        <axis xyz="0 1 0"/>

    </joint>

</robot>